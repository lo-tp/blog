#!/bin/sh
# Hugo entry point for this repo.
#
# The old version of this script downloaded hugo_0.166.0_darwin_arm64.tar.gz, which does
# not exist: Hugo 0.166.0 ships no macOS tarball (only darwin-universal.pkg), so that path
# can never work on a Mac. Use the Hugo installed on PATH instead — Homebrew's hugo is the
# same version CI pins — and warn when it is not.
#
# In GitHub Actions this file is replaced by the binary CI downloads, so CI never runs it.
set -e

pinned="0.166.0"

if command -v hugo >/dev/null 2>&1; then
  found=$(hugo version 2>/dev/null | sed -n 's/^hugo v\([0-9][0-9.]*\).*/\1/p' | head -n 1)
  if [ -n "$found" ] && [ "$found" != "$pinned" ]; then
    echo "warning: local hugo $found differs from the version CI pins ($pinned)" >&2
  fi
  exec hugo "$@"
fi

echo "error: hugo is not installed. Install it with: brew install hugo" >&2
exit 1
